<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RUIF 组件验证台（开发用）。构建消费方视角：只引用 RUIF.dll 成品，
    与真实第三方 Mod 的接入方式一致 —— 因此本工程能编译通过，本身即
    「RUIF 公开 API 对消费方可用」的回归证据。
    先构建框架：dotnet build Source/RUIF.csproj
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>RUIF.Demo</RootNamespace>
    <AssemblyName>RUIF_Demo</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- 输出直接进本 Mod 的 Assemblies/（游戏加载目录） -->
    <OutputPath>$(MSBuildProjectDirectory)\..\Assemblies\</OutputPath>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">E:\SteamLibrary\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldPath)\RimWorldWin64_Data\Managed\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 被验证对象：RUIF 成品程序集（不复制到输出，运行时由游戏统一加载 Mods 下各 Mod 的 Assemblies） -->
    <Reference Include="RUIF">
      <HintPath>$(MSBuildProjectDirectory)\..\..\..\Assemblies\RUIF.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
